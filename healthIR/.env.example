# LINE Login 設定
# 在 LINE Developers Console 建立 Login channel 後取得
LINE_CHANNEL_ID=YOUR_LINE_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET
LINE_REDIRECT_URI=https://REGION-PROJECT_ID.cloudfunctions.net/lineAuthCallback

# Firebase 設定
# 在 Firebase Console > 專案設定 > 服務帳戶 下載憑證
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CRED_PATH=serviceAccount.json
# Firebase Console > 專案設定 > 一般 > 網頁 API 金鑰
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# Cloud Function 部署路徑 (部署後會顯示)
FIREBASE_FUNCTION_URL=https://REGION-PROJECT_ID.cloudfunctions.net/lineAuthCallback
